<robot name="cube_base">
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.9 0.6 0.8"/>
      </geometry>
      <material name="wood">
        <color rgba="0.85 0.72 0.45 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.9 0.6 0.8"/>
      </geometry>
    </collision>

    <inertial>
      <!-- Mass of the cube -->
      <mass value="0.4902"/>

      <!-- Inertia tensor values for the cube -->
      <inertia 
        ixx="0.000817" ixy="0.0" ixz="0.0" 
        iyy="0.000817" iyz="0.0" 
        izz="0.000817"/>
    </inertial>

    <contact>
      <lateral_friction value="0.5"/>
      <rolling_friction value="0.01"/>
      <spinning_friction value="0.01"/>
      <restitution value="0.2"/>
    </contact>
  </link>

</robot>
